# ──────────────────────────────────────────────────────────────
# Ximo — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file with real secrets.
# The app is built to run (and `npm run build` to pass) even when
# these are empty — Supabase features simply stay disabled.
# ──────────────────────────────────────────────────────────────

# Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Project Settings → API → anon public)
# Safe to expose to the browser; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (Project Settings → API → service_role)
# SERVER-ONLY. Bypasses RLS. Never expose to the browser. Used by
# trusted server code (Stripe webhook, admin tasks). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────────────────
# Demo mode. ON by default (free access, no payment). Set to "false"
# to move to the paid launch — Stripe checkout then takes over.
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEMO_MODE=true

# ──────────────────────────────────────────────────────────────
# Stripe billing (optional — the app builds & runs without these;
# checkout falls back to the manual activation RPC when absent).
# ──────────────────────────────────────────────────────────────

# Public site URL used for OG/Twitter link previews and Stripe return URLs.
NEXT_PUBLIC_SITE_URL=https://ximo.app
# App URL for Stripe success/cancel redirects (defaults to NEXT_PUBLIC_SITE_URL).
NEXT_PUBLIC_APP_URL=https://ximo.app

# Stripe secret key (Dashboard → Developers → API keys). SERVER-ONLY.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret. Local: `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe`. Prod: Dashboard → Webhooks endpoint.
STRIPE_WEBHOOK_SECRET=
# Recurring Price ids for each plan (Dashboard → Products).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Optional $0.00/month price. When set + DEMO_MODE on, the demo runs through a
# real Stripe checkout at $0 (no card required) instead of the manual RPC.
STRIPE_PRICE_DEMO=

# ──────────────────────────────────────────────────────────────
# Transactional email (optional — Resend). Absent → in-app
# notifications still work; emails are simply not sent.
# ──────────────────────────────────────────────────────────────
# Resend API key (resend.com → API Keys). SERVER-ONLY.
RESEND_API_KEY=
# Verified sender (Resend → Domains). Must be a domain you verified.
EMAIL_FROM="Ximo <hola@tudominio.com>"

# ──────────────────────────────────────────────────────────────
# Comunidad Ximo en Discord. Invite link del servidor. Mientras no
# esté configurado, el botón "Entrar al Discord" se muestra
# deshabilitado ("Discord invite pendiente").
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_DISCORD_INVITE_URL=

# ──────────────────────────────────────────────────────────────
# Publicación de anuncios en Discord (solo admin, siempre manual).
# SERVIDOR ÚNICAMENTE — nunca exponer con prefijo NEXT_PUBLIC_.
# Opción A (recomendada): webhook del canal de anuncios.
# Opción B: bot con permiso de escribir en el canal.
# Sin configurar → el panel admin muestra instrucciones de publicación manual.
# ──────────────────────────────────────────────────────────────
DISCORD_ADS_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_ADS_CHANNEL_ID=

# ──────────────────────────────────────────────────────────────
# Revisión manual de anuncios. Las solicitudes nuevas se envían por
# correo a este buzón (requiere RESEND_API_KEY + EMAIL_FROM).
# ──────────────────────────────────────────────────────────────
XIMO_REVIEW_EMAIL=ximoacademy@gmail.com
# Link de pago externo usado en el correo de aprobación cuando Stripe
# no está configurado. TODO: retirar al activar el proveedor de pagos.
PAYMENT_LINK_PLACEHOLDER=

# ──────────────────────────────────────────────────────────────
# Daily reminders cron (Vercel Cron → /api/cron/reminders).
# Vercel sends `Authorization: Bearer ${CRON_SECRET}` automatically.
# Needs SUPABASE_SERVICE_ROLE_KEY to read across users + send.
# ──────────────────────────────────────────────────────────────
CRON_SECRET=
